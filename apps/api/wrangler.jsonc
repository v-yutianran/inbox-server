{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inbox-server-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "inbox-api.yutianran.cn",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inbox-server",
      "database_id": "8654ef2f-4f7b-4f9e-837a-7aeb4388fd64",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "inbox-server-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10
      }
    ],
    "producers": [
      {
        "binding": "JOBS",
        "queue": "inbox-server-jobs"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "SCHEDULE_ENABLED": "true",
    "SYNC_PUBLISH_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
