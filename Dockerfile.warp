FROM debian:12.11-slim@sha256:b1a741487078b369e78119849663d7f1a5341ef2768798f7b7406c4240f86aef AS package

ARG CLOUDFLARE_WARP_VERSION=2026.6.880.0

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl gpg \
    && curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg \
    && printf '%s\n' \
      'deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ bookworm main' \
      > /etc/apt/sources.list.d/cloudflare-client.list \
    && apt-get update \
    && cd /tmp \
    && apt-get download "cloudflare-warp=${CLOUDFLARE_WARP_VERSION}" \
    && dpkg-deb --extract cloudflare-warp_*.deb /warp-root \
    && rm -rf /var/lib/apt/lists/*

FROM debian:12.11-slim@sha256:b1a741487078b369e78119849663d7f1a5341ef2768798f7b7406c4240f86aef

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      ca-certificates \
      libcap2 \
      libdbus-1-3 \
      libgcrypt20 \
      liblz4-1 \
      libnspr4 \
      libnss3 \
      libssl3 \
      libsystemd0 \
      libtss2-esys-3.0.2-0 \
      libtss2-tctildr0 \
      libzstd1 \
      tini \
    && useradd --create-home --home-dir /home/warp --shell /usr/sbin/nologin --uid 1001 warp \
    && install -d -o warp -g warp -m 0700 \
      /run/cloudflare-warp \
      /var/lib/cloudflare-warp \
      /var/log/cloudflare-warp \
    && rm -rf /var/lib/apt/lists/*

COPY --from=package /warp-root/bin/warp-cli /bin/warp-cli
COPY --from=package /warp-root/bin/warp-svc /bin/warp-svc

COPY --chown=warp:warp deploy/warp/entrypoint.sh /usr/local/bin/inbox-warp-entrypoint

RUN chmod 0755 /usr/local/bin/inbox-warp-entrypoint \
    && ! ldd /bin/warp-cli /bin/warp-svc | grep -q 'not found'

ENV WARP_PROXY_PORT=40000

USER 1001:1001

VOLUME ["/var/lib/cloudflare-warp"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/inbox-warp-entrypoint"]
