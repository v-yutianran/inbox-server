# 渠道配置（客户私有化部署时拷贝改名 channels.yaml，填真实凭据到 .env）
# ${ENV} 从环境变量插值，凭据不落 yaml 明文

sources:
  telegram:
    enabled: true
    config: {bot_token: "${TELEGRAM_BOT_TOKEN}"}
  dida:
    enabled: true
    config: {access_token: "${DIDA365_ACCESS_TOKEN}"}
  github_stars:
    enabled: true
    config: {token: "${GITHUB_TOKEN}"}
  zhihu:
    enabled: true
    kind: BROWSER
    config: {collection_id: "${ZHIHU_COLLECTION_ID}", credential_name: "zhihu_creds"}
  bilibili:
    enabled: true
    kind: BROWSER
    config: {media_id: "${BILIBILI_MEDIA_ID}", credential_name: "bilibili_creds"}
  bilibili_toview:
    enabled: true
    kind: BROWSER
    config: {credential_name: "bilibili_creds"}
  inoreader:
    enabled: true
    kind: BROWSER
    config: {credential_name: "inoreader_creds"}
  youtube:
    enabled: true
    kind: BROWSER
    config: {credential_name: "youtube_creds"}
  x_bookmarks:
    enabled: true
    kind: BROWSER
    config: {credential_name: "x_creds"}
  x_likes:
    enabled: true
    kind: BROWSER
    config: {credential_name: "x_creds", username: "${X_USERNAME}"}

destinations:
  cubox:
    enabled: true
    item_kind: link
    config: {api_url: "${CUBOX_API_KEY}"}
  flomo:
    enabled: true
    item_kind: text
    config: {webhook: "${FLOMO_WEBHOOK}"}
  jianguoyun:
    enabled: true
    item_kind: file
    config: {webdav_user: "${JIANGUOYUN_WEBDAV_USER}", webdav_pass: "${JIANGUOYUN_WEBDAV_PASS}"}

# 仅归档 Cubox 成功的新链接；仓库克隆到 Sealos PVC，GITHUB_TOKEN 需有写权限。
article_archive:
  enabled: true
  repository_dir: /data/archive/repository
  articles_dir: references/article
  min_visible_characters: 200
  http_timeout_seconds: 30
  browser_timeout_seconds: 45
  defuddle_timeout_seconds: 30
  max_html_bytes: 8000000
  max_output_bytes: 10000000
  enqueue_attempts: 3
  rate_window_count: 60
  rate_window_seconds: 3600
  daily_limit: 10000
  interval_seconds: 5

credentials: {}
#   zhihu_creds: {platform: zhihu, kind: cookie, vault_id: "zhihu_main"}

# 有新内容才发送；任一通知通道失败不会阻塞主流程。
notification:
  telegram_chat_id: "${TELEGRAM_CHAT_ID}"
  notify_token: "${TELEGRAM_NOTIFY_TOKEN}"
  smtp_host: "${SMTP_HOST}"
  smtp_port: 465
  smtp_user: "${SMTP_USER}"
  smtp_pass: "${SMTP_PASS}"
  email_from: "${EMAIL_FROM}"
  email_to: "${EMAIL_TO}"

llm:
  glm_api_key: "${Z_AI_API_KEY}"
  model: "glm-4-flash"
